# =============================================================================
# RATIONALIZATION PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================

# Node Environment
NODE_ENV=development

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rationalization
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme123

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme123

# Elasticsearch
ELASTICSEARCH_NODE=http://elasticsearch:9200

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme123

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI (for embeddings and AI classification)
OPENAI_API_KEY=sk-your-openai-api-key-here

# HuggingFace (alternative AI provider)
HUGGINGFACE_API_KEY=your-huggingface-token-here

# GitHub (for crawler)
GITHUB_TOKEN=ghp_your-github-personal-access-token

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# MONITORING
# =============================================================================

# Grafana admin password
GRAFANA_PASSWORD=admin

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Catalog API
CATALOG_API_PORT=3000

# AI Classifier
AI_CLASSIFIER_PORT=8001

# API Gateway
API_GATEWAY_PORT=8000

# Frontend Web App
WEB_APP_PORT=3002

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Sentry (error tracking)
SENTRY_DSN=

# Segment (analytics)
SEGMENT_WRITE_KEY=
